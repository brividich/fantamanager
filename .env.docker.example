# ==============================================================================
# FantaManager - Docker Environment Variables
# Copy this file to .env.docker or configure via docker-compose.yml
# ==============================================================================

# Port to expose on the host machine (default: 8000)
PORT=8000

# Security secret key (generate a long random string for production)
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Debug mode (False for production, True for local development)
DJANGO_DEBUG=False

# Allowed hosts (comma-separated, e.g. localhost,127.0.0.1,asta.miodominio.it or *)
DJANGO_ALLOWED_HOSTS=*

# CSRF trusted origins for remote or tunnel URLs
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL Database Configuration
POSTGRES_DB=fantamanager
POSTGRES_USER=fantamanager
POSTGRES_PASSWORD=fantamanager_secret_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432
