# ==============================================================================
# FantaManager - Docker Environment Variables
# Copy this file to .env.docker or configure via docker-compose.yml
# ==============================================================================

# Porta sulla macchina (NAS o PC). Di default risponde solo a 127.0.0.1: ci
# arriva il reverse proxy che porta l'HTTPS (su Synology: Proxy inverso verso
# http://localhost:8088). Per un uso solo in LAN, senza proxy: FM_BIND=0.0.0.0
PORT=8088
# FM_BIND=127.0.0.1

# Chiave segreta: lasciala VUOTA. L'entrypoint ne genera una vera al primo
# avvio e la conserva in ./data/.secret_key. Se ne vuoi una tua:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Mai un valore copiato da qui o da un altro file del repository: e' pubblico.
DJANGO_SECRET_KEY=

# Debug mode (False for production, True for local development)
DJANGO_DEBUG=False

# OBBLIGATORIA. I nomi da cui si apre l'app, separati da virgola: il tuo
# dominio e, se lo usi in LAN, l'IP del NAS. Mai «*»: con «*» un link delle
# email (reset password) potrebbe essere costruito verso un sito qualsiasi.
DJANGO_ALLOWED_HOSTS=fantamanager.example.it

# L'indirizzo pubblico https dell'installazione (solo schema e dominio): da qui
# partono i link delle email ed è un'origine fidata per i form.
FM_SITE_URL=https://fantamanager.example.it

# True SOLO se davanti c'è il reverse proxy e la porta resta su 127.0.0.1.
# Con la porta aperta a tutti, chiunque potrebbe fingersi un altro indirizzo.
DJANGO_BEHIND_PROXY=True

# Altre origini da cui arrivano i form (oltre a FM_SITE_URL). Niente «*».
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Privacy (docs/PRIVACY.md). Titolare del trattamento e contatto mostrati in
# /privacy/: chi gestisce questa installazione.
FM_PRIVACY_OWNER=
FM_PRIVACY_EMAIL=
# Giorni dopo cui si azzerano IP e dispositivo delle offerte, e si cancellano
# gli account registrati e mai confermati (senza squadre né leghe).
FM_RETENTION_BID_IP_DAYS=90
FM_RETENTION_UNVERIFIED_DAYS=30

# PostgreSQL Database Configuration
POSTGRES_DB=fantamanager
POSTGRES_USER=fantamanager
POSTGRES_PASSWORD=fantamanager_secret_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API-Football (api-sports.io): anagrafica dei calciatori, club di chi esce
# dalla Serie A e voti live. Facoltativa: senza chiave il club si indica a mano
# e i voti si caricano da file. Per i voti live serve un piano a pagamento.
APIFOOTBALL_KEY=

# Statistiche di stagione applicate da sole a ogni import del listone: un file
# tuo (export «Statistiche» .xlsx/.csv). L'app non ne include uno.
# FANTAMANAGER_STATS_FILE=/app/data/statistiche.xlsx  (cartella ./data accanto al compose)
# FANTAMANAGER_STATS_SEASON=2025/26
