# Copy this file to ".env" and adjust as needed.

# Secret key — generate a random one for anything beyond local testing.
DJANGO_SECRET_KEY=dev-insecure-change-me

# Debug mode (True for development, False otherwise).
DJANGO_DEBUG=True

# Comma-separated allowed hosts. "*" is fine for a trusted LAN.
DJANGO_ALLOWED_HOSTS=*

# Needed only if you serve over HTTPS / a proxy and hit CSRF issues.
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8000

# Minimum milliseconds between two bids from the same participant (anti-spam).
BID_MIN_INTERVAL_MS=300

# How often (seconds) the server pushes a timer sync over WebSocket.
TIMER_SYNC_INTERVAL_SECONDS=2

# --- Public access tokens ---------------------------------------------------
# When True, the read-only TV screen and the bidder join require an unguessable
# token (?t=... / link squadra). Leave False for trusted LAN, True online.
# The Docker image turns it on unless you set it to False.
PUBLIC_TOKENS_REQUIRED=False

# --- Production: database (PostgreSQL) --------------------------------------
# Set POSTGRES_DB to switch from SQLite to Postgres (requires the psycopg pkg).
# POSTGRES_DB=fantamanager
# POSTGRES_USER=fantamanager
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# Docker compose: the "backup" service dumps the database into ./backups every
# BACKUP_EVERY_HOURS hours (and after each auction), keeping BACKUP_KEEP files.
# BACKUP_EVERY_HOURS=6
# BACKUP_KEEP=30

# --- Production: Channels layer (Redis) -------------------------------------
# Multi-process WebSocket layer (requires the channels-redis pkg).
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Production: static files -----------------------------------------------
# Destination of `collectstatic` (defaults to ./staticfiles). WhiteNoise serves
# it automatically when the package is installed.
# DJANGO_STATIC_ROOT=/var/www/fantamanager/static

# --- Production: HTTPS hardening (only applied when DJANGO_DEBUG=False) ------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
# Set when running behind a TLS-terminating reverse proxy (nginx/Render/Heroku).
# DJANGO_BEHIND_PROXY=True

# API-Football (api-sports.io): trova il club dei giocatori usciti dalla Serie A.
# Facoltativa: senza chiave il club si indica a mano.
APIFOOTBALL_KEY=

# --- Posta in uscita (facoltativa) -------------------------------------------
# Di solito si configura dalla console: Impostazioni → Posta. Queste variabili
# valgono solo finché quella pagina è spenta.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tuo.indirizzo@gmail.com
# EMAIL_HOST_PASSWORD=password-per-le-app
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=FantaManager <tuo.indirizzo@gmail.com>
